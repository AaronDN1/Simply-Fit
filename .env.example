# Supabase (leave blank to run Simply Fit in local demo mode — data stays in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for account deletion and health-data ingest.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (leave blank to use the built-in offline food estimator)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public site URL, used for OAuth and password-reset redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
