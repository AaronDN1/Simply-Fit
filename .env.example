# Supabase (leave blank to run Simply Fit in local demo mode — data stays in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required in production for account deletion and the daily AI limit.
# Cloud AI is refused until this key and the 0002 migration are in place.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI. Leave blank to use the built-in estimator.
# When set, cloud AI still requires a signed-in Supabase user. A blank Supabase URL cannot spend this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# none | minimal | low | medium | high — higher is smarter but uses more tokens
OPENAI_REASONING_EFFORT=low

# Public site URL, used for OAuth, password-reset, and Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Billing. Use a restricted key (rk_) when you can. Never expose this to the browser.
# Webhook signing secret from the Stripe endpoint that posts to /api/billing/webhook.
# STRIPE_WEBHOOK_SECRET_LOCAL is filled by the local Stripe CLI forwarder, when one is running.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_LOCAL=
